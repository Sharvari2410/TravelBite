NODE_ENV=development

# Preferred: one full URL
# Example: postgresql://postgres:postgres@localhost:5432/travelbite
DATABASE_URL=

# Optional per-field config (used if DATABASE_URL not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=travelbite

# Set to require when using managed cloud DB SSL
PGSSLMODE=disable
